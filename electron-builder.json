{
  "appId": "jp.unlitcube.nfc-tag-studio",
  "productName": "NFC Tag Studio",
  "copyright": "Copyright (c) 2026 UnlitCube",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "out/**/*",
    "!out/**/.bundled-modules.json",
    "!**/*.map",
    "package.json",
    "!**/node_modules/koffi/doc/**",
    "!**/node_modules/koffi/vendor/**",
    "!**/node_modules/koffi/lib/**",
    "!**/node_modules/koffi/src/**/*.{cc,hh,h,inc,S,asm,def,txt}",
    "!**/node_modules/koffi/CHANGELOG.md",
    "!**/node_modules/@koromix/**/*.{lib,exp,pdb}"
  ],
  "asarUnpack": [
    "**/node_modules/koffi/**",
    "**/node_modules/@koromix/**"
  ],
  "extraResources": [
    {
      "from": "LICENSE",
      "to": "LICENSE.txt"
    },
    {
      "from": "THIRD_PARTY_NOTICES.txt",
      "to": "THIRD_PARTY_NOTICES.txt"
    }
  ],
  "npmRebuild": false,
  "publish": null,
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "NFC-Tag-Studio-${version}-win-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "NFC-Tag-Studio-${version}-win-${arch}-portable.${ext}"
  }
}
